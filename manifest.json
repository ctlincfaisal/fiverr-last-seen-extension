{
  "manifest_version": 3,
  "name": "Inbox Last Seen (Unofficial)",
  "version": "0.3.0",
  "description": "Unofficial, local-only inbox last-seen viewer. No automatic reloads or extension-initiated Fiverr requests.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Inbox Last Seen \u2014 open popup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fiverr.com/*",
        "https://www.fiverr.com/*",
        "https://pro.fiverr.com/*"
      ],
      "js": [
        "capture-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fiverr.com/*",
        "https://www.fiverr.com/*",
        "https://pro.fiverr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
